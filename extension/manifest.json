{
  "manifest_version": 3,
  "name": "ZoonLogos",
  "version": "1.0.0",
  "description": "Prime Video için bağlamsal İngilizce-Türkçe altyazı yardımcısı.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://zoonlogos-api.onrender.com/*",
    "https://www.primevideo.com/*",
    "https://*.primevideo.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZoonLogos",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://*.primevideo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
  