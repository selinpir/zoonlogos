{
  "manifest_version": 3,
  "name": "ZoonLogos",
  "version": "1.0.0",
  "description": "Prime Video için bağlamsal İngilizce-Türkçe altyazı yardımcısı.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://zoonlogos-api.onrender.com/*",
    "https://www.primevideo.com/*",
    "https://*.primevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZoonLogos"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://*.primevideo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}